{
  "expo": {
    "name": "ZWAG",
    "slug": "ZWAG",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zwag",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mark-zwe.ZWAG"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#272B2C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.markzwe.ZWAG"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#272B2C",
          "userInterfaceStyle": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
